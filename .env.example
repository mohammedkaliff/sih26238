# Comma-separated administrator emails accepted by the API.
ADMIN_EMAILS=umarfarookm198@gmail.com,mohammedkaliff10@gmail.com

# Shared administrator password for the local demo portal.
# Use a long, unique value and keep .env out of version control.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional API port. Vite proxies /api requests here during development.
PORT=3001

# Set to production when serving over HTTPS so the session cookie is Secure.
NODE_ENV=development
